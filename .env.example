ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost

# Админка (обязательны оба значения, иначе вход закрыт на сервере)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Developer mode for a local instance served over HTTP only.
# ADMIN_ALLOW_INSECURE_HTTP=true
SESSION_SECRET=

# Telegram-уведомления администратору о новых площадках и обращениях
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Публичный адрес Courtmap для ссылок «Открыть карточку» / «Управлять».
# Для локального Docker-прогона: http://localhost
PUBLIC_BASE_URL=

# Опционально: build-args для прод-сборки фронтенда (по умолчанию VITE_API_BASE_URL="" и публичные ключи Яндекса из frontend/.env.production)
# VITE_API_BASE_URL=
# VITE_YANDEX_MAPS_KEY=a777c097-a5ec-4c58-b9a9-e23f94bfd245
# VITE_YANDEX_GEOCODER_KEY=a6a9006b-a9a8-48b9-ae46-009f99c6cb84
