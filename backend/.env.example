DATABASE_URL=sqlite:///./data/courtmap.db
CORS_ORIGINS=http://localhost:5173,https://courtmap.example.com
LOG_LEVEL=INFO

# Старый токен DELETE /courts/{id}: работает только если задан НЕ стандартный токен.
# Пусто или change-me — старый DELETE отключён (503).
ADMIN_TOKEN=change-me

# Админка (см. README, раздел «Админка и Telegram»).
# ADMIN_PASSWORD и SESSION_SECRET обязаны быть заданы явно, иначе вход закрыт (fail-closed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Developer mode for a local instance served over HTTP only.
# ADMIN_ALLOW_INSECURE_HTTP=true
SESSION_SECRET=
# Время жизни сессии, часы (по умолчанию 12)
# ADMIN_SESSION_TTL_HOURS=12

# Telegram-уведомления администратору
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Публичный адрес Courtmap для ссылок «Открыть карточку» / «Управлять».
# Пример: https://hizm-xjs6-o8dd.gw-1a.dockhost.net
PUBLIC_BASE_URL=
