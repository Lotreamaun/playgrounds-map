VITE_API_BASE_URL=https://api.courtmap.example.com
VITE_YANDEX_MAPS_KEY=your-yandex-maps-js-api-key
# Yandex HTTP Geocoder API key (separate from the Maps JS API key above)
VITE_YANDEX_GEOCODER_KEY=your-yandex-geocoder-api-key
# Необязательно: канал обратной связи для ссылки «Сообщить о проблеме» в карточке площадки.
# {id} заменяется на id площадки. Пусто — ссылка не показывается. Примеры:
#   https://t.me/your_bot?start=court_{id}
#   https://forms.gle/xxxx?entry.123456={id}
#   mailto:feedback@example.com?subject=CourtMap%20{id}
VITE_REPORT_URL=
